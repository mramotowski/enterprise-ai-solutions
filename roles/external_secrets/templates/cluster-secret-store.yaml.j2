{# One ClusterSecretStore per openbao_layers entry (tasks/install.yaml).
   Stable vault provider (AD-15) against OpenBao KV v2, Kubernetes auth as role
   eso-<layer> with a token minted for the ESO ServiceAccount (audience
   openbao_auth_audience). serviceAccountRef.namespace is set on purpose:
   without it the store is "referent" and ESO would use a ServiceAccount of the
   ExternalSecret's namespace. Only namespaces labelled
   secrets.ai-solutions/<layer>: "true" may use the store. #}
{% for s in _eso_stores %}
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: {{ s.name | to_json }}
  labels:
{% for k, v in external_secrets_store_labels.items() %}
    {{ k | to_json }}: {{ v | to_json }}
{% endfor %}
    {{ (external_secrets_namespace_label_prefix ~ 'layer') | to_json }}: {{ s.layer | to_json }}
spec:
  conditions:
    - namespaceSelector:
        matchLabels:
          {{ (external_secrets_namespace_label_prefix ~ s.layer) | to_json }}: "true"
  provider:
    vault:
      server: {{ _eso_server | to_json }}
      path: {{ _eso_kv_mount | to_json }}
      version: v2
      caProvider:
        type: ConfigMap
        name: {{ _eso_ca_configmap | to_json }}
        namespace: {{ _eso_openbao_namespace | to_json }}
        key: ca.crt
      auth:
        kubernetes:
          mountPath: {{ _eso_auth_mount | to_json }}
          role: {{ ('eso-' ~ s.layer) | to_json }}
          serviceAccountRef:
            name: {{ external_secrets_service_account_name | to_json }}
            namespace: {{ external_secrets_namespace | to_json }}
            audiences:
              - {{ _eso_audience | to_json }}
{% endfor %}
