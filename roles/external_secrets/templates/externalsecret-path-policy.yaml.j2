---
# Pin each namespace's ExternalSecrets to the OpenBao paths it may read (AD-7).
#
# Every layer in openbao_layers has one ClusterSecretStore openbao-<layer>,
# usable from every namespace labelled secrets.ai-solutions/<layer>: "true".
# Without this policy, anyone allowed to create an ExternalSecret in such a
# namespace could read any credential of the layer through it. The layer
# exports, per namespace, the paths its projections read: the annotation
# secrets.ai-solutions/<layer>-paths on the Namespace, a comma-separated list
# of KV paths relative to <cluster_id>/ (e.g. erag/keycloak/erag-admin). Only
# cluster-scoped RBAC can patch a Namespace.
#
# For each entry whose effective store is one of the openbao-<layer>
# ClusterSecretStores (data[].sourceRef.storeRef, dataFrom[].sourceRef.storeRef,
# else spec.secretStoreRef; kind defaults to SecretStore), the policy requires:
#   - the namespace carries the layer label,
#   - data[].remoteRef.key or dataFrom[].extract.key (dataFrom.find is
#     refused: it enumerates paths),
#   - the key is <cluster_id>/<p> for a p listed in the annotation that lies
#     under <layer>/.
# Entries using any other store or a generator are not restricted here.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: {{ external_secrets_path_policy_name }}
  labels:
    app.kubernetes.io/name: external-secrets
    app.kubernetes.io/managed-by: ai-solutions-installer
spec:
  failurePolicy: Fail
  matchConstraints:
    # v1 is the only served ExternalSecret version in ESO 2.x; matchPolicy
    # Equivalent (default) would also cover a version served later.
    resourceRules:
      - apiGroups: ["external-secrets.io"]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["externalsecrets"]
  matchConditions:
    # ESO patches finalizers and its own metadata on existing objects (also
    # while one is being deleted); an update that leaves spec unchanged grants
    # nothing new.
    - name: spec-changed
      expression: "request.operation != 'UPDATE' || !has(oldObject.spec) || !has(object.spec) || object.spec != oldObject.spec"
  variables:
    # ClusterSecretStore name -> layer, rendered from openbao_layers.
    - name: stores
      expression: >-
        {{ '{' }}{% for s in _eso_stores %}{{ s.name | to_json }}: {{ s.layer | to_json }}{% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }}
    - name: cid
      expression: {{ (_eso_cluster_id | string | to_json) | to_json }}
    # Layer of spec.secretStoreRef, '' when it is not an OpenBao store.
    - name: defaultLayer
      expression: >-
        object.?spec.?secretStoreRef.?kind.orValue('SecretStore') == 'ClusterSecretStore'
        ? variables.stores[?object.?spec.?secretStoreRef.?name.orValue('')].orValue('')
        : ''
    # One entry per data[] / dataFrom[] item: {layer, key, mode}; layer '' =
    # not an OpenBao store.
    - name: refs
      expression: >-
        object.?spec.?data.orValue([]).map(d, {
          'layer': (has(d.sourceRef) && has(d.sourceRef.storeRef))
            ? (d.sourceRef.storeRef.?kind.orValue('SecretStore') == 'ClusterSecretStore'
               ? variables.stores[?d.sourceRef.storeRef.?name.orValue('')].orValue('') : '')
            : variables.defaultLayer,
          'key': string(d.?remoteRef.?key.orValue('')),
          'mode': 'data'})
        + object.?spec.?dataFrom.orValue([]).map(f, {
          'layer': (has(f.sourceRef) && has(f.sourceRef.generatorRef)) ? ''
            : ((has(f.sourceRef) && has(f.sourceRef.storeRef))
              ? (f.sourceRef.storeRef.?kind.orValue('SecretStore') == 'ClusterSecretStore'
                 ? variables.stores[?f.sourceRef.storeRef.?name.orValue('')].orValue('') : '')
              : variables.defaultLayer),
          'key': string(f.?extract.?key.orValue('')),
          'mode': has(f.find) ? 'find' : (has(f.extract) ? 'extract' : 'other')})
    - name: ours
      expression: "variables.refs.filter(r, r.layer != '')"
    - name: nsLabels
      expression: "namespaceObject.metadata.?labels.orValue({})"
    - name: nsAnnotations
      expression: "namespaceObject.metadata.?annotations.orValue({})"
    # The entries whose key is not allowed in this namespace.
    - name: deniedKeys
      expression: >-
        variables.ours.filter(r, (r.mode == 'data' || r.mode == 'extract') && !(
          r.key.startsWith(variables.cid + '/' + r.layer + '/') &&
          variables.nsAnnotations[?({{ external_secrets_namespace_label_prefix | to_json }} + r.layer + {{ external_secrets_paths_annotation_suffix | to_json }})]
            .orValue('').split(',')
            .exists(p, p.trim().startsWith(r.layer + '/') && variables.cid + '/' + p.trim() == r.key)))
  validations:
    - expression: >-
        variables.ours.all(r,
          variables.nsLabels[?({{ external_secrets_namespace_label_prefix | to_json }} + r.layer)].orValue('') == 'true')
      messageExpression: >-
        "ExternalSecret '" + object.metadata.namespace + "/" + object.metadata.name +
        "' uses an OpenBao ClusterSecretStore, but namespace '" + object.metadata.namespace +
        "' is not enabled for it (missing label " +
        variables.ours.filter(r, variables.nsLabels[?({{ external_secrets_namespace_label_prefix | to_json }} + r.layer)].orValue('') != 'true')
          .map(r, {{ external_secrets_namespace_label_prefix | to_json }} + r.layer + '=true').join(', ') + ")."
      reason: Forbidden
    - expression: "variables.ours.all(r, r.mode == 'data' || r.mode == 'extract')"
      messageExpression: >-
        "ExternalSecret '" + object.metadata.namespace + "/" + object.metadata.name +
        "': OpenBao ClusterSecretStores allow only data[].remoteRef.key and dataFrom[].extract.key (dataFrom.find is not allowed)."
      reason: Forbidden
    - expression: "variables.deniedKeys.size() == 0"
      messageExpression: >-
        "ExternalSecret '" + object.metadata.namespace + "/" + object.metadata.name +
        "' reads OpenBao paths not allowed in namespace '" + object.metadata.namespace + "': " +
        variables.deniedKeys.map(r, r.key + ' (store ' + {{ external_secrets_store_prefix | to_json }} + r.layer + ')').join(', ') +
        ". Allowed: the paths in annotation " + {{ external_secrets_namespace_label_prefix | to_json }} + "<layer>" +
        {{ external_secrets_paths_annotation_suffix | to_json }} + " of the namespace, as " + variables.cid + "/<path>."
      reason: Forbidden
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ external_secrets_path_policy_name }}
  labels:
    app.kubernetes.io/name: external-secrets
    app.kubernetes.io/managed-by: ai-solutions-installer
spec:
  policyName: {{ external_secrets_path_policy_name }}
  validationActions: ["Deny"]
